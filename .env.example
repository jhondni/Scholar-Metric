# .env.example - Variáveis de ambiente do Analitcs School
# Copie este arquivo para .env e preencha os valores

# Flask
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=sua-chave-secreta-aqui

# Banco de Dados PostgreSQL
DATABASE_URL=postgresql://postgres:sua_senha@localhost:5432/analitcs_school

# Configurações de Upload
MAX_UPLOAD_SIZE=16
