# .flaskenv - Configurações automáticas para Flask CLI
# Este arquivo é lido automaticamente pelo Flask CLI (python-dotenv)
# NÃO precisa ser versionado em produção

# Apontar para o módulo que contém a variável 'app'
FLASK_APP=app.py

# Ambiente de desenvolvimento
FLASK_ENV=development

# Debug ativado em desenvolvimento
FLASK_DEBUG=1

# Porta do servidor
FLASK_RUN_PORT=5000

# Host (0.0.0.0 permite acesso externo)
FLASK_RUN_HOST=0.0.0.0
