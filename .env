# .env - Variáveis de ambiente do Analitcs School
# NUNCA commite este arquivo no repositório

# Flask
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=analitcs-school-secret-key-2026

# Banco de Dados PostgreSQL (desenvolvimento local)
# Formato: postgresql://usuario:senha@host:porta/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/analitcs_school

# Configurações de Upload
MAX_UPLOAD_SIZE=16
